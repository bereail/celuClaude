# Copiar a .env y completar. Nunca commitear el .env real.

# Clave de la API de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Modelo a usar para la orquestacion
CLAUDE_MODEL=claude-sonnet-5

# Solo necesario si tu API key es "identity-linked" (viene de una cuenta con
# Workspaces). Si te falta, la API te lo dice clarito en un error 400:
# "anthropic-workspace-id is required...". Lo encontras en
# console.anthropic.com -> Settings -> Workspaces (la URL tiene el id).
ANTHROPIC_WORKSPACE_ID=

# Secreto para firmar JWTs. Generar con: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-secret

# Minutos de vida del access token / dias del refresh token
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Token que el/los agentes de PC usan para registrarse (compartido, rotable)
AGENT_ENROLLMENT_TOKEN=change-me-enrollment-token

# Base de datos
DATABASE_URL=sqlite:///./command_center.db

# Usuario unico de la app (MVP single-user)
APP_USER_EMAIL=me@example.com
APP_USER_PASSWORD_HASH=
